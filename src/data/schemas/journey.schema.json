{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["steps"],
  "properties": {
    "steps": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["id", "stepNumber", "title", "description", "order"],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/Id" },
          "stepNumber": { "type": "string", "pattern": "^0[1-4]$" },
          "title": { "$ref": "common.schema.json#/$defs/Localized" },
          "description": { "$ref": "common.schema.json#/$defs/Localized" },
          "order": { "type": "integer", "minimum": 1, "maximum": 4 }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
