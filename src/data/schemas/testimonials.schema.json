{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["items"],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "consent", "sourceLanguage", "languages", "order"],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/Id" },
          "type": { "enum": ["testimonial", "progress-story", "result", "screenshot"] },
          "consent": {
            "type": "object",
            "properties": { "granted": { "const": true } },
            "required": ["granted"]
          },
          "sourceLanguage": { "enum": ["en", "ar"] },
          "images": { "type": "array" },
          "order": { "type": "integer", "minimum": 1 }
        },
        "allOf": [
          {
            "if": { "properties": { "type": { "const": "screenshot" } } },
            "then": { "properties": { "images": { "minItems": 1 } } }
          }
        ]
      }
    }
  }
}
