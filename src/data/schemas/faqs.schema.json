{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["items"],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "question", "answer", "order", "published"],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/Id" },
          "question": { "$ref": "common.schema.json#/$defs/Localized" },
          "answer": { "$ref": "common.schema.json#/$defs/Localized" },
          "order": { "type": "integer", "minimum": 1 },
          "published": { "type": "boolean" },
          "needsConfirmation": { "type": "string", "pattern": "^DR-\\d{2}$" }
        }
      }
    }
  }
}
